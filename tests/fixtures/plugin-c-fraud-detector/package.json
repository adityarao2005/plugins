{
  "name": "@fixture/plugin-c-fraud-detector",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:bundle": "bun build ./src/index.ts --outfile ./dist/index.js --target browser --format esm",
    "build:plugin": "bun ../../../apps/cli/dist/index.js -e ./dist/index.js -p ./package.json -a ./assets -o ./dist/plugin-c-fraud-detector.plugin",
    "build": "bun run build:bundle && bun run build:plugin",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fixture/plugin-a-ledger": "workspace:*",
    "@repo/core": "workspace:*",
    "zod": "^4.6.7"
  }
}
